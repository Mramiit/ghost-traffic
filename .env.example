# ==============================================================================
# Ghost Traffic - AI-Driven Autonomous Chaos QA Swarm
# Environment Configuration Template
# BharatCode Build League Hackathon (https://bharatcode.ai/hackathon)
# ==============================================================================

# BharatCode Intelligence Engine Settings (OpenAI-compatible)
# 1. Sign up / login at https://bharatcode.ai
# 2. Copy your API Key from your account profile (format: bc_live_...)
# 3. Paste it below as BHARATCODE_API_KEY
BHARATCODE_API_KEY=bc_live_your_api_key_here
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1

# Supported BharatCode models:
# - qwen-3.8-27b (Recommended: reasoning, coding, and tool use)
# - deepseek-v4.1-flash (Long-context reasoning & coding)
BHARATCODE_MODEL=qwen-3.8-27b

# Legacy / Standard OpenAI Settings (Optional fallback if not using BharatCode)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Target System Under Test (SUT) Configuration
TARGET_SERVER_HOST=127.0.0.1
TARGET_SERVER_PORT=8000
TARGET_SERVER_URL=http://127.0.0.1:8000
TARGET_SCHEMA_PATH=target_server/sample_schema.json

# Chaos Swarm Execution Settings
CHAOS_CONCURRENCY=3
CHAOS_MAX_ROUNDS=10
CHAOS_TIMEOUT_SECONDS=10.0
CHAOS_OUTPUT_DIR=./reports
